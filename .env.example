DB_PASSWORD=1234

# Segredos obrigatórios da API. Copie este arquivo para .env (que é ignorado pelo git)
# e preencha os dois valores — sem eles a API não inicia (fail-closed em Program.cs).
#
#   JWT_SECRET  — assina os access tokens. Mínimo de 32 bytes.
#                 Gerar: openssl rand -base64 48
#   ENCRYPTION_KEY — chave AES-256 dos documentos em disco. Base64 de exatamente 32 bytes.
#                 Gerar: openssl rand -base64 32
#
# Atenção: trocar ENCRYPTION_KEY torna ilegíveis os documentos já gravados com a chave anterior.
JWT_SECRET=
ENCRYPTION_KEY=
